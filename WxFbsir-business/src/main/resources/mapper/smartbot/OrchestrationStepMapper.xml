<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wx.fbsir.business.smartbot.mapper.OrchestrationStepMapper">
    <resultMap id="StepResult" type="com.wx.fbsir.business.smartbot.domain.OrchestrationStep">
        <id property="stepId" column="step_id"/>
        <result property="runId" column="run_id"/>
        <result property="stepKey" column="step_key"/>
        <result property="attempt" column="attempt"/>
        <result property="kind" column="kind"/>
        <result property="executorType" column="executor_type"/>
        <result property="executorRef" column="executor_ref"/>
        <result property="status" column="status"/>
        <result property="inputHash" column="input_hash"/>
        <result property="outputRef" column="output_ref"/>
        <result property="evidenceRef" column="evidence_ref"/>
        <result property="version" column="version"/>
        <result property="leaseOwner" column="lease_owner"/>
        <result property="leaseUntil" column="lease_until"/>
        <result property="errorCode" column="error_code"/>
        <result property="errorMessage" column="error_message"/>
        <result property="startedAt" column="started_at"/>
        <result property="finishedAt" column="finished_at"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
    <insert id="insertStep">
        INSERT INTO fbs_orchestration_step
            (step_id, run_id, step_key, attempt, kind, executor_type, executor_ref,
             status, input_hash, output_ref, evidence_ref, version,
             started_at, finished_at, create_time, update_time)
        VALUES
            (#{stepId}, #{runId}, #{stepKey}, #{attempt}, #{kind}, #{executorType}, #{executorRef},
             #{status}, #{inputHash}, #{outputRef}, #{evidenceRef}, #{version},
             #{startedAt}, #{finishedAt}, NOW(), NOW())
    </insert>
    <select id="selectByRunStepAttemptForUpdate" resultMap="StepResult">
        SELECT * FROM fbs_orchestration_step
        WHERE run_id = #{runId} AND step_key = #{stepKey} AND attempt = #{attempt}
        FOR UPDATE
    </select>
</mapper>
