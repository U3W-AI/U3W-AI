<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wx.fbsir.business.smartbot.mapper.WecomBotBindingMapper">
    <resultMap id="BindingResult" type="com.wx.fbsir.business.smartbot.domain.WecomBotBinding">
        <id property="id" column="id"/>
        <result property="callbackKey" column="callback_key"/>
        <result property="aibotId" column="aibot_id"/>
        <result property="enterpriseId" column="enterprise_id"/>
        <result property="mode" column="mode"/>
        <result property="tokenSecretRef" column="token_secret_ref"/>
        <result property="aesKeySecretRef" column="aes_key_secret_ref"/>
        <result property="credentialVersion" column="credential_version"/>
        <result property="status" column="status"/>
        <result property="createdBy" column="created_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>
    <select id="selectActiveByCallbackKey" resultMap="BindingResult">
        SELECT id, callback_key, aibot_id, enterprise_id, mode,
               token_secret_ref, aes_key_secret_ref, credential_version,
               status, created_by, create_time, updated_by, update_time, del_flag
        FROM fbs_bot_binding
        WHERE callback_key = #{callbackKey} AND status = 1 AND del_flag = '0'
        LIMIT 1
    </select>
    <select id="selectActiveById" resultMap="BindingResult">
        SELECT id, callback_key, aibot_id, enterprise_id, mode,
               token_secret_ref, aes_key_secret_ref, credential_version,
               status, created_by, create_time, updated_by, update_time, del_flag
        FROM fbs_bot_binding
        WHERE id = #{id} AND status = 1 AND del_flag = '0'
        LIMIT 1
    </select>
</mapper>
