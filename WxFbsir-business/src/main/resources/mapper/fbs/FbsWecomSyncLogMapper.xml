<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wx.fbsir.business.fbs.mapper.FbsWecomSyncLogMapper">

    <resultMap type="com.wx.fbsir.business.fbs.domain.entity.FbsWecomSyncLog" id="FbsWecomSyncLogResult">
        <id     property="id"            column="id" />
        <result property="syncType"      column="sync_type" />
        <result property="sheetName"     column="sheet_name" />
        <result property="status"        column="status" />
        <result property="recordCount"   column="record_count" />
        <result property="errorCode"     column="error_code" />
        <result property="errorMessage"  column="error_message" />
        <result property="snapshotJson"  column="snapshot_json" />
        <result property="durationMs"    column="duration_ms" />
        <result property="createdBy"     column="created_by" />
        <result property="createdTime"   column="created_time" />
    </resultMap>

    <insert id="insertSyncLog" parameterType="com.wx.fbsir.business.fbs.domain.entity.FbsWecomSyncLog"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO fbs_wecom_sync_log (
            sync_type, sheet_name, status, record_count,
            error_code, error_message, snapshot_json, duration_ms,
            created_by, created_time
        ) VALUES (
            #{log.syncType}, #{log.sheetName}, #{log.status}, #{log.recordCount},
            #{log.errorCode}, #{log.errorMessage}, #{log.snapshotJson}, #{log.durationMs},
            #{log.createdBy}, NOW()
        )
    </insert>

</mapper>
