<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wx.fbsir.business.fbs.mapper.FbsEnterpriseMemberMapper">

    <resultMap type="com.wx.fbsir.business.fbs.domain.entity.FbsEnterpriseMember" id="FbsEnterpriseMemberResult">
        <id     property="id"               column="id"                />
        <result property="enterpriseId"     column="enterprise_id"    />
        <result property="userId"            column="user_id"           />
        <result property="role"              column="role"              />
        <result property="joinTime"           column="join_time"         />
        <result property="status"             column="status"            />
        <result property="createdBy"          column="created_by"       />
        <result property="createTime"         column="create_time"       />
        <result property="updatedBy"          column="updated_by"       />
        <result property="updateTime"         column="update_time"      />
        <result property="delFlag"            column="del_flag"         />
    </resultMap>

    <sql id="selectFbsEnterpriseMemberVo">
        SELECT id, enterprise_id, user_id, role, join_time,
               status, created_by, create_time, updated_by, update_time, del_flag
        FROM fbs_enterprise_member
    </sql>

    <select id="selectById" parameterType="Long" resultMap="FbsEnterpriseMemberResult">
        <include refid="selectFbsEnterpriseMemberVo"/>
        WHERE id = #{id} AND del_flag = '0'
    </select>

    <select id="selectByEnterpriseAndUser" resultMap="FbsEnterpriseMemberResult">
        <include refid="selectFbsEnterpriseMemberVo"/>
        WHERE enterprise_id = #{enterpriseId}
          AND user_id = #{userId}
          AND del_flag = '0'
    </select>

    <select id="selectActiveByUserId" parameterType="Long" resultMap="FbsEnterpriseMemberResult">
        <include refid="selectFbsEnterpriseMemberVo"/>
        WHERE user_id = #{userId}
          AND status = 1
          AND del_flag = '0'
    </select>

    <select id="selectActiveByEnterpriseId" parameterType="Long" resultMap="FbsEnterpriseMemberResult">
        <include refid="selectFbsEnterpriseMemberVo"/>
        WHERE enterprise_id = #{enterpriseId}
          AND status = 1
          AND del_flag = '0'
    </select>

    <select id="selectMemberList" parameterType="com.wx.fbsir.business.fbs.domain.entity.FbsEnterpriseMember" resultMap="FbsEnterpriseMemberResult">
        <include refid="selectFbsEnterpriseMemberVo"/>
        <where>
            del_flag = '0'
            <if test="filter.enterpriseId != null">
                AND enterprise_id = #{filter.enterpriseId}
            </if>
            <if test="filter.userId != null">
                AND user_id = #{filter.userId}
            </if>
            <if test="filter.status != null">
                AND status = #{filter.status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <insert id="insertMember" parameterType="com.wx.fbsir.business.fbs.domain.entity.FbsEnterpriseMember"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO fbs_enterprise_member
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="enterpriseId != null">enterprise_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="role != null">role,</if>
            <if test="joinTime != null">join_time,</if>
            <if test="status != null">status,</if>
            <if test="createdBy != null">created_by,</if>
            create_time,
            del_flag
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="enterpriseId != null">#{enterpriseId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="role != null">#{role},</if>
            <if test="joinTime != null">#{joinTime},</if>
            <if test="status != null">#{status},</if>
            <if test="createdBy != null">#{createdBy},</if>
            NOW(),
            '0'
        </trim>
    </insert>

    <update id="updateMember" parameterType="com.wx.fbsir.business.fbs.domain.entity.FbsEnterpriseMember">
        UPDATE fbs_enterprise_member
        <trim prefix="SET" suffixOverrides=",">
            <if test="role != null">role = #{role},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updatedBy != null">updated_by = #{updatedBy},</if>
            update_time = NOW()
        </trim>
        WHERE id = #{id} AND del_flag = '0'
    </update>

</mapper>
