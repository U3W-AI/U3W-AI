  "policy": {
    "defaultStage": "fix",
    "releaseBlockers": [
      "contract",
      "backend",
      "frontend",
      "verify",
      "database-transactions",
      "database-plan-policy",
      "database-skill-consume-credit-v2",
      "database-menu-migrations",
      "plan-policy-admin-ui",
      "traffic-attribution"
    ],
    "requiredReleaseBlockers": [
      "contract",
      "backend",
      "frontend",
      "verify",
      "database-transactions",
      "database-plan-policy",
      "database-skill-consume-credit-v2",
      "database-menu-migrations",
      "plan-policy-admin-ui",
      "traffic-attribution"
    ],
    "requiredWorkflowCommands": {
      "verify": [
        "contract",
        "backend",
        "frontend",
        "verify",
        "database-transactions",
        "database-plan-policy",
        "database-skill-consume-credit-v2",
        "database-menu-migrations",
        "plan-policy-admin-ui",
        "traffic-attribution"
      ]
    },
    "applicationRuntimeEvidenceCommands": [
      "board-http-security",
      "database-transactions",
      "database-plan-policy",
      "database-skill-consume-credit-v2",
      "database-menu-migrations",
      "plan-policy-admin-ui",
      "traffic-attribution"
    ],
    "w1ScratchEvidenceCommands": [
      "database-live",
      "database-concurrency"
    ],
    "requiresContractDrivenFlow": true,
    "listedExpertPackageFrozen": true,
    "productionWriteRequiresApproval": true,
    "staticVerificationCannotProveLiveDatabase": true
  },
  "workflows": {
    "assess": [
      "contract"
    ],
    "fix": [
      "contract"
    ],
    "verify": [
      "contract",
      "backend",
      "frontend",
      "verify",
      "database-transactions",
      "database-plan-policy",
      "database-skill-consume-credit-v2",
      "database-menu-migrations",
      "plan-policy-admin-ui",
      "traffic-attribution"
    ]
  },
  "contracts": {
    "authoritativeRoot": {
      "mode": "standalone_git_repository",
      "externalDirectoryDependency": "forbidden",
      "runtimeAssetsMustBeRepositoryRelative": true,
      "githubRemote": "https://github.com/U3W-AI/U3W-AI.git",
      "alignmentRule": "one_commit_one_migration_manifest_one_deployment_receipt",
      "conflictPrecedence": [
        "repository_contract_and_current_product_principles",
        "repository_current_code_tests_and_migrations",
        "github_same_commit_state",
        "current_service_readback",
