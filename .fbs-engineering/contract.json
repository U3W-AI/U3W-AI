{
  "surface": "u3w-control-plane",
  "id": "independent-board-control-plane",
  "summary": "U3W control plane for the FBSir Independent Review Board user and administration portals",
  "versionSource": "docs/independent-board/implementation-status.json",
  "commands": {
    "contract": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-control-plane.ps1 -Mode Contract",
      "cwd": ".",
      "timeout_ms": 120000
    },
    "backend": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-control-plane.ps1 -Mode Backend",
      "cwd": ".",
      "timeout_ms": 600000
    },
    "board-http-security": {
      "run": "mvn -pl FBSir-admin -am \"-Dtest=IndependentBoardHttpSecurityIntegrationTest,IndependentBoard*Test\" \"-Dsurefire.failIfNoSpecifiedTests=false\" test",
      "cwd": ".",
      "timeout_ms": 600000
    },
    "frontend": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-control-plane.ps1 -Mode Frontend",
      "cwd": ".",
      "timeout_ms": 600000
    },
    "verify": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-control-plane.ps1 -Mode All",
      "cwd": ".",
      "timeout_ms": 900000
    },
    "database-live": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-live-database.ps1 -Database $env:U3W_LIVE_TEST_DATABASE -LoginPath $env:U3W_LIVE_TEST_LOGIN_PATH -MySqlExe $env:U3W_MYSQL_EXE -Json",
      "cwd": ".",
      "timeout_ms": 900000
    },
    "database-concurrency": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-mysql-concurrency.ps1 -Database $env:U3W_LIVE_TEST_DATABASE -LoginPath $env:U3W_LIVE_TEST_LOGIN_PATH -MySqlExe $env:U3W_MYSQL_EXE",
      "cwd": ".",
      "timeout_ms": 300000
    },
    "database-transactions": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-independent-board-mysql-transaction-it.ps1 -AllowDestructiveTest",
      "cwd": ".",
      "timeout_ms": 900000
    },
    "database-plan-policy": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-independent-board-plan-policy-mysql-it.ps1 -AllowDestructiveTest -EmitMetadataSnapshot",
      "cwd": ".",
      "timeout_ms": 900000
    },
    "database-skill-consume-credit-v2": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-independent-board-skill-consume-credit-ledger-v2-mysql-it.ps1 -AllowDestructiveTest",
      "cwd": ".",
      "timeout_ms": 900000
    },
    "plan-policy-admin-ui": {
      "run": "node FBSir-ui/scripts/verify-independent-board-plan-policy-admin-ui.mjs",
      "cwd": ".",
      "timeout_ms": 120000
    },
    "database-menu-migrations": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-independent-board-menu-migration-it.ps1 -AllowDestructiveTest",
      "cwd": ".",
      "timeout_ms": 900000
    },
    "traffic-attribution": {
      "run": "node --test scripts/independent-board-traffic-attribution.test.mjs",
      "cwd": ".",
      "timeout_ms": 120000
    },
    "w4b2d-evidence": {
      "run": "node --test scripts/independent-board-w4b2d-evidence-contract.test.mjs",
      "cwd": ".",
      "timeout_ms": 120000
    },
    "api2-p1005-candidate": {
      "run": "node scripts/build-api2-p1-005-candidate.mjs && node tools/independent-board-p1-005-candidate-smoke.mjs work/api2-cleanroom/p1-005-candidate-20260722/source",
      "cwd": ".",
      "timeout_ms": 120000
    },
    "api2-p1005-closure-audit": {
      "run": "node scripts/capture-api2-cleanroom-closure.mjs --root work/api2-cleanroom/p1-005-active-20260722/source --output work/api2-cleanroom/p1-005-active-20260722/root/api2-p1-005-closure-manifest.local.json",
      "cwd": ".",
      "timeout_ms": 120000
    },
    "java-attribution-boundary-contract": {
      "run": "node --test scripts/independent-board-java-boundary-contract.test.mjs",
      "cwd": ".",
      "timeout_ms": 120000
    },
    "w1a-official-attribution": {
      "run": "mvn -o -pl FBSir-business \"-Dtest=BoardAttributionEventV1VerifierTest,BoardIntentClassifierTest,BoardSameBindingKeyDeriverTest,BoardTrafficClassificationResolverTest,IndependentBoardAttribution*Test\" \"-DforkCount=0\" test",
      "cwd": ".",
      "timeout_ms": 300000
    },
    "w1a-dual-mysql": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-independent-board-attribution-v1-mysql-it.ps1 -AllowDestructiveTest",
      "cwd": ".",
      "timeout_ms": 600000
    },
    "w1a-production-readiness-rules": {
      "run": "node --test scripts/independent-board-production-readiness.test.mjs",
      "cwd": ".",
      "timeout_ms": 120000
    },
    "w1a-preparation-contract": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-u3w-preparation-contract.ps1",
      "cwd": ".",
      "timeout_ms": 300000
    },
    "w1a-legacy-control-shape-mysql": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-u3w-legacy-baseline-control-shape-mysql-it.ps1 -AllowDestructiveTest",
      "cwd": ".",
      "timeout_ms": 300000
    },
    "w1a-production-backup-restore": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-u3w-production-backup-restore.ps1 -Mode $env:U3W_BACKUP_MODE -ExpectedCommit $env:U3W_EXPECTED_COMMIT -RunId $env:U3W_RUN_ID -ApprovalReceiptPath $env:U3W_APPROVAL_RECEIPT",
      "cwd": ".",
      "timeout_ms": 1800000
    },
    "w1a-default-off-configuration": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-u3w-default-off-configuration.ps1 -Mode $env:U3W_CONFIGURATION_MODE -ExpectedCommit $env:U3W_EXPECTED_COMMIT -ExpectedEnvironmentSha256 $env:U3W_EXPECTED_ENVIRONMENT_SHA256 -ExpectedConfiguredEnvironmentSha256 $env:U3W_EXPECTED_CONFIGURED_ENVIRONMENT_SHA256 -OriginalApprovalReceiptSha256 $env:U3W_ORIGINAL_APPROVAL_RECEIPT_SHA256 -RunId $env:U3W_RUN_ID -ApprovalReceiptPath $env:U3W_APPROVAL_RECEIPT -AnchorOutputDirectory $env:U3W_ANCHOR_OUTPUT_DIRECTORY",
      "cwd": ".",
      "timeout_ms": 300000
    },
    "w1a-legacy-baseline": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-u3w-legacy-baseline.ps1 -Mode $env:U3W_BASELINE_MODE -ExpectedCommit $env:U3W_EXPECTED_COMMIT -ExpectedBackupBundleReceiptSha256 $env:U3W_BACKUP_RECEIPT_SHA256 -ExpectedAdoptionReceiptSha256 $env:U3W_EXPECTED_ADOPTION_RECEIPT_SHA256 -OriginalApprovalReceiptSha256 $env:U3W_ORIGINAL_APPROVAL_RECEIPT_SHA256 -RunId $env:U3W_RUN_ID -ApprovalReceiptPath $env:U3W_APPROVAL_RECEIPT -AnchorOutputDirectory $env:U3W_ANCHOR_OUTPUT_DIRECTORY",
      "cwd": ".",
      "timeout_ms": 300000
    },
    "w1a-default-off-release": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-independent-board-default-off.ps1 -Mode $env:U3W_RELEASE_MODE -ExpectedCommit $env:U3W_EXPECTED_COMMIT -ReleaseId $env:U3W_RELEASE_ID -BuildReceiptPath $env:U3W_BUILD_RECEIPT -ExpectedBuildReceiptSha256 $env:U3W_BUILD_RECEIPT_SHA256 -PlanReceiptPath $env:U3W_RELEASE_PLAN_RECEIPT -ExpectedReleasePlanReceiptSha256 $env:U3W_RELEASE_PLAN_RECEIPT_SHA256 -ExpectedBackupReceiptSha256 $env:U3W_BACKUP_RECEIPT_SHA256 -ExpectedLegacyBaselineReceiptDigest $env:U3W_LEGACY_BASELINE_RECEIPT_SHA256 -ExpectedConfigurationReceiptSha256 $env:U3W_CONFIGURATION_RECEIPT_SHA256 -ExpectedStageReceiptSha256 $env:U3W_STAGE_RECEIPT_SHA256 -ExpectedDeploymentReceiptSha256 $env:U3W_DEPLOYMENT_RECEIPT_SHA256 -ApprovalReceiptPath $env:U3W_APPROVAL_RECEIPT -PlanOutputPath $env:U3W_PLAN_OUTPUT_PATH -ExternalEvidenceDirectory $env:U3W_EXTERNAL_EVIDENCE_DIRECTORY",
      "cwd": ".",
      "timeout_ms": 900000
    },
    "w1a-production-readiness-live": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-production-readiness.ps1",
      "cwd": ".",
      "timeout_ms": 120000
    }
  },
