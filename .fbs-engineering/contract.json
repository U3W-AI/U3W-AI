{
  "surface": "u3w-control-plane",
  "id": "independent-board-control-plane",
  "summary": "U3W control plane for the FBSir Independent Review Board user and administration portals",
  "versionSource": "docs/independent-board/implementation-status.json",
  "commands": {
    "contract": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-control-plane.ps1 -Mode Contract",
      "cwd": ".",
      "timeout_ms": 120000
    },
    "backend": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-control-plane.ps1 -Mode Backend",
      "cwd": ".",
      "timeout_ms": 600000
    },
    "board-http-security": {
      "run": "mvn -pl FBSir-admin -am \"-Dtest=IndependentBoardHttpSecurityIntegrationTest,IndependentBoard*Test\" \"-Dsurefire.failIfNoSpecifiedTests=false\" test",
      "cwd": ".",
      "timeout_ms": 600000
    },
    "frontend": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-control-plane.ps1 -Mode Frontend",
      "cwd": ".",
      "timeout_ms": 600000
    },
    "verify": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-control-plane.ps1 -Mode All",
      "cwd": ".",
      "timeout_ms": 900000
    },
    "database-live": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-live-database.ps1 -Database $env:U3W_LIVE_TEST_DATABASE -LoginPath $env:U3W_LIVE_TEST_LOGIN_PATH -MySqlExe $env:U3W_MYSQL_EXE -Json",
      "cwd": ".",
      "timeout_ms": 900000
    },
    "database-concurrency": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-mysql-concurrency.ps1 -Database $env:U3W_LIVE_TEST_DATABASE -LoginPath $env:U3W_LIVE_TEST_LOGIN_PATH -MySqlExe $env:U3W_MYSQL_EXE",
      "cwd": ".",
      "timeout_ms": 300000
    },
    "database-transactions": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-independent-board-mysql-transaction-it.ps1 -AllowDestructiveTest",
      "cwd": ".",
      "timeout_ms": 900000
    }
  },
  "artifacts": {
    "taskboard": "docs/independent-board/taskboard.json",
    "status": "docs/independent-board/implementation-status.json",
    "domainInventory": "config/deployment/u3w-domain-inventory.json",
    "migrations": "sql/update_20260720_independent_board_control_plane.sql",
    "portalMenuMigration": "sql/update_20260720_independent_board_me_menu.sql",
    "portalAdminMenuMigration": "sql/update_20260720_independent_board_admin_menu.sql",
    "w2VerificationReport": "reports/independent-board/w2-user-portal-verification-20260720.json",
    "w3VerificationReport": "reports/independent-board/w3-admin-portal-verification-20260720.json",
    "verificationReports": "reports/independent-board/*.json"
  },
  "policy": {
    "defaultStage": "fix",
    "releaseBlockers": [
      "contract",
      "backend",
      "frontend",
      "verify",
      "database-transactions"
    ],
    "requiredReleaseBlockers": [
      "contract",
      "backend",
      "frontend",
      "verify",
      "database-transactions"
    ],
    "requiredWorkflowCommands": {
      "verify": [
        "contract",
        "backend",
        "frontend",
        "verify",
        "database-transactions"
      ]
    },
    "applicationRuntimeEvidenceCommands": [
      "board-http-security",
      "database-transactions"
    ],
    "w1ScratchEvidenceCommands": [
      "database-live",
      "database-concurrency"
    ],
    "requiresContractDrivenFlow": true,
    "submittedExpertPackageFrozen": true,
    "productionWriteRequiresApproval": true,
    "staticVerificationCannotProveLiveDatabase": true
  },
  "workflows": {
    "assess": [
      "contract"
    ],
    "fix": [
      "contract"
    ],
    "verify": [
      "contract",
      "backend",
      "frontend",
      "verify",
      "database-transactions"
    ]
  },
  "contracts": {
    "authoritativeRoot": {
      "mode": "standalone_git_repository",
      "externalDirectoryDependency": "forbidden",
      "runtimeAssetsMustBeRepositoryRelative": true,
      "githubRemote": "https://github.com/U3W-AI/U3W-AI.git",
      "alignmentRule": "one_commit_one_migration_manifest_one_deployment_receipt",
      "conflictPrecedence": [
        "repository_contract_and_current_product_principles",
        "repository_current_code_tests_and_migrations",
        "github_same_commit_state",
        "current_service_readback",
        "historical_external_materials"
      ]
    },
    "frozenSurface": {
      "productId": "fbsir-eight-seat-board",
      "version": "26.7.20",
      "state": "submitted_for_review",
      "writePolicy": "forbidden_during_review",
      "sourceDependency": false
    },
    "controlPlane": {
      "userPortal": "https://me.u3w.com",
      "adminPortal": "https://admin.u3w.com",
      "domainInventory": "config/deployment/u3w-domain-inventory.json",
      "frontendBase": "FBSir-ui existing RuoYi Vue 3 and Element Plus shell",
      "reuseRule": "extend_existing_identity_role_menu_permission_layout_and_component_system",
      "parallelFrontendFramework": "forbidden",
      "controlOwner": "U3W",
      "runtimeOwner": "FBSir Hub and approved runtime adapters",
      "systemOfRecordOwner": "U3W plus bound first-party systems",
      "tenantRequiredForPersonalUsers": true,
      "defaultPortalEntry": {
        "path": "/portal-entry",
        "meRoute": "IndependentBoardMe",
        "fallbackPath": "/index",
        "permissionRule": "hostname_selects_default_experience_only_after_dynamic_route_authorization"
      },
      "adminAccessModel": {
        "current": "global_system_admin_only",
        "controllerGuard": "admin_role_and_fine_grained_board_permission",
        "delegatedTenantAdministration": "not_implemented",
        "menuRoleBinding": "not_created_by_w3a"
      }
    },
    "uiPrototypeGate": {
      "prototype": "docs/independent-board/prototypes/portals/index.html",
      "specification": "docs/independent-board/PORTAL-PROTOTYPE-SPEC.md",
      "productionUiImplementationAllowed": true,
      "unlockCondition": "satisfied_by_explicit_user_confirmation_2026_07_20",
      "confirmation": {
        "state": "confirmed",
        "decision": "recommended_five_points",
        "confirmedAt": "2026-07-20T21:03:00+08:00"
      },
      "w2Implementation": {
        "state": "local_source_and_integration_verified",
        "surface": "FBSir-ui/src/views/business/independentBoard/me/index.vue",
        "scope": [
          "entitlement_quota_meeting_dashboard",
          "server_derived_enterprise_context",
          "connector_activation_state",
          "idempotent_reservation_and_exact_readback",
          "host_aware_default_entry"
        ],
        "deferred": [
          "connector_oauth_self_service",
          "webhook_deep_page",
          "watch_deep_page"
        ]
      },
      "w3aImplementation": {
        "state": "local_source_and_integration_verified",
        "menuRoot": "IndependentBoardAdmin",
        "surfaces": [
          "FBSir-ui/src/views/business/independentBoard/admin/entitlement/index.vue",
          "FBSir-ui/src/views/business/independentBoard/admin/meetingAudit/index.vue"
        ],
        "scope": [
          "active_enterprise_and_member_locked_entitlement_grant_or_adjustment",
          "strict_safe_admin_entitlement_projection",
          "bounded_safe_meeting_operation_audit",
          "global_admin_role_and_fine_permission_separation",
          "first_apply_rerun_collision_and_menu_current_read"
        ],
        "deferred": [
          "delegated_tenant_admin_role",
          "entitlement_revoke_and_expiry_actions",
          "entitlement_receipt_audit_page",
          "credit_ledger_operations",
          "connector_and_device_operations"
        ]
      },
      "mustReuse": [
        "FBSir-ui/src/layout",
        "FBSir-ui/src/router",
        "FBSir-ui/src/store/modules/permission.js",
        "FBSir-ui/src/utils/request.js",
        "Element Plus",
        "existing menu and permission conventions"
      ]
    },
    "identityAndEntitlement": {
      "identityRefs": [
        "anonymousJourneyRef",
        "principalSubjectRef",
        "tenantId",
        "channelBindingId",
        "runId"
      ],
      "oauthScopes": [
        "identity.read",
        "entitlement.read",
        "board.meeting.reserve",
        "board.receipt.write"
      ],
      "failClosed": true
    },
    "firstVerticalSlice": {
      "flow": [
        "authenticated_principal",
        "vip_entitlement_snapshot",
        "meeting_quota_reservation",
        "user_portal_readback",
        "admin_portal_audit_readback"
      ],
      "requiresIdempotencyDigest": true,
      "requiresTenantIsolation": true,
      "requiresImmutableAudit": true,
      "externalSideEffects": false
    },
    "receiptBoundary": {
      "levels": [
        "ACTION_ACCEPTED",
        "ACTION_COMPLETED",
        "PROVIDER_ACCEPTED",
        "PROVIDER_REJECTED",
        "UNKNOWN",
        "DELIVERED",
        "INTERACTED",
        "BUSINESS_CONFIRMED"
      ],
      "noCrossLevelInference": true
    },
    "publicBoundary": {
      "exclude": [
        "secrets",
        "cookies",
        "real_tokens",
        "tenant_exports",
        "internal_evidence",
        "review_package_changes"
      ]
    }
  }
}
