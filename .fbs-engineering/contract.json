{
  "surface": "u3w-control-plane",
  "id": "independent-board-control-plane",
  "summary": "U3W control plane for the FBSir Independent Review Board user and administration portals",
  "versionSource": "docs/independent-board/implementation-status.json",
  "commands": {
    "contract": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-control-plane.ps1 -Mode Contract",
      "cwd": ".",
      "timeout_ms": 120000
    },
    "backend": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-control-plane.ps1 -Mode Backend",
      "cwd": ".",
      "timeout_ms": 600000
    },
    "board-http-security": {
      "run": "mvn -pl FBSir-admin -am \"-Dtest=IndependentBoardHttpSecurityIntegrationTest,IndependentBoard*Test\" \"-Dsurefire.failIfNoSpecifiedTests=false\" test",
      "cwd": ".",
      "timeout_ms": 600000
    },
    "frontend": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-control-plane.ps1 -Mode Frontend",
      "cwd": ".",
      "timeout_ms": 600000
    },
    "verify": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-control-plane.ps1 -Mode All",
      "cwd": ".",
      "timeout_ms": 900000
    },
    "database-live": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-live-database.ps1 -Database $env:U3W_LIVE_TEST_DATABASE -LoginPath $env:U3W_LIVE_TEST_LOGIN_PATH -MySqlExe $env:U3W_MYSQL_EXE -Json",
      "cwd": ".",
      "timeout_ms": 900000
    },
    "database-concurrency": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-independent-board-mysql-concurrency.ps1 -Database $env:U3W_LIVE_TEST_DATABASE -LoginPath $env:U3W_LIVE_TEST_LOGIN_PATH -MySqlExe $env:U3W_MYSQL_EXE",
      "cwd": ".",
      "timeout_ms": 300000
    },
    "database-transactions": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-independent-board-mysql-transaction-it.ps1 -AllowDestructiveTest",
      "cwd": ".",
      "timeout_ms": 900000
    },
    "database-menu-migrations": {
      "run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-independent-board-menu-migration-it.ps1 -AllowDestructiveTest",
      "cwd": ".",
      "timeout_ms": 900000
    }
  },
  "artifacts": {
    "taskboard": "docs/independent-board/taskboard.json",
    "status": "docs/independent-board/implementation-status.json",
    "domainInventory": "config/deployment/u3w-domain-inventory.json",
    "migrations": "sql/update_20260720_independent_board_control_plane.sql",
    "portalMenuMigration": "sql/update_20260720_independent_board_me_menu.sql",
    "portalAdminMenuMigration": "sql/update_20260720_independent_board_admin_menu.sql",
    "portalEntitlementLifecycleMenuMigration": "sql/update_20260720_independent_board_entitlement_lifecycle_menu.sql",
    "w3bLifecycleContract": "docs/independent-board/W3B-ENTITLEMENT-LIFECYCLE-CONTRACT.md",
    "w4aConnectorBindingContract": "docs/independent-board/W4A-AUTHORITATIVE-CONNECTOR-BINDING-CONTRACT.md",
    "w4aConnectorBindingMigration": "sql/update_20260721_independent_board_connector_binding.sql",
    "w4aVerificationReport": "reports/independent-board/w4a-authoritative-connector-binding-verification-20260721.json",
    "w2VerificationReport": "reports/independent-board/w2-user-portal-verification-20260720.json",
    "w3VerificationReport": "reports/independent-board/w3-admin-portal-verification-20260720.json",
    "w3bVerificationReport": "reports/independent-board/w3b-entitlement-lifecycle-verification-20260720.json",
    "verificationReports": "reports/independent-board/*.json"
  },
  "policy": {
    "defaultStage": "fix",
    "releaseBlockers": [
      "contract",
      "backend",
      "frontend",
      "verify",
      "database-transactions",
      "database-menu-migrations"
    ],
    "requiredReleaseBlockers": [
      "contract",
      "backend",
      "frontend",
      "verify",
      "database-transactions",
      "database-menu-migrations"
    ],
    "requiredWorkflowCommands": {
      "verify": [
        "contract",
        "backend",
        "frontend",
        "verify",
        "database-transactions",
        "database-menu-migrations"
      ]
    },
    "applicationRuntimeEvidenceCommands": [
      "board-http-security",
      "database-transactions",
      "database-menu-migrations"
    ],
    "w1ScratchEvidenceCommands": [
      "database-live",
      "database-concurrency"
    ],
    "requiresContractDrivenFlow": true,
    "submittedExpertPackageFrozen": true,
    "productionWriteRequiresApproval": true,
    "staticVerificationCannotProveLiveDatabase": true
  },
  "workflows": {
    "assess": [
      "contract"
    ],
    "fix": [
      "contract"
    ],
    "verify": [
      "contract",
      "backend",
      "frontend",
      "verify",
      "database-transactions",
      "database-menu-migrations"
    ]
