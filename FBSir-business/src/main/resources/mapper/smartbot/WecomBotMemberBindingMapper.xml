<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wx.fbsir.business.smartbot.mapper.WecomBotMemberBindingMapper">
    <resultMap id="MemberBindingResult" type="com.wx.fbsir.business.smartbot.domain.WecomBotMemberBinding">
        <id property="id" column="id"/>
        <result property="botBindingId" column="bot_binding_id"/>
        <result property="enterpriseId" column="enterprise_id"/>
        <result property="enterpriseMemberId" column="enterprise_member_id"/>
        <result property="userId" column="user_id"/>
        <result property="externalUserHash" column="external_user_hash"/>
        <result property="status" column="status"/>
        <result property="createdBy" column="created_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>
    <select id="selectActiveByExternalHash" resultMap="MemberBindingResult">
        SELECT id, bot_binding_id, enterprise_id, enterprise_member_id, user_id,
               external_user_hash, status, created_by, create_time,
               updated_by, update_time, del_flag
        FROM fbs_bot_member_binding
        WHERE bot_binding_id = #{botBindingId}
          AND external_user_hash = #{externalUserHash}
          AND status = 1 AND del_flag = '0'
        LIMIT 1
    </select>
</mapper>
