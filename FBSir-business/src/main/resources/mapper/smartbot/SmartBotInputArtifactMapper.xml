<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wx.fbsir.business.smartbot.mapper.SmartBotInputArtifactMapper">
    <resultMap id="ArtifactResult" type="com.wx.fbsir.business.smartbot.domain.SmartBotInputArtifact">
        <id property="id" column="id"/>
        <result property="inputRef" column="input_ref"/>
        <result property="purpose" column="purpose"/>
        <result property="inboundEventId" column="inbound_event_id"/>
        <result property="runId" column="run_id"/>
        <result property="botBindingId" column="bot_binding_id"/>
        <result property="enterpriseId" column="enterprise_id"/>
        <result property="enterpriseMemberId" column="enterprise_member_id"/>
        <result property="userId" column="user_id"/>
        <result property="msgType" column="msg_type"/>
        <result property="sourcePayloadHash" column="source_payload_hash"/>
        <result property="contentHash" column="content_hash"/>
        <result property="cipherAlgorithm" column="cipher_algorithm"/>
        <result property="keyRef" column="key_ref"/>
        <result property="keyVersion" column="key_version"/>
        <result property="nonce" column="nonce"/>
        <result property="ciphertext" column="ciphertext"/>
        <result property="aadHash" column="aad_hash"/>
        <result property="plaintextSize" column="plaintext_size"/>
        <result property="status" column="status"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <insert id="insertArtifact" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO fbs_smartbot_input_artifact
            (input_ref, purpose, inbound_event_id, run_id, bot_binding_id,
             enterprise_id, enterprise_member_id, user_id, msg_type,
             source_payload_hash, content_hash, cipher_algorithm, key_ref,
             key_version, nonce, ciphertext, aad_hash, plaintext_size, status,
             expires_at, create_time, update_time)
        VALUES
            (#{inputRef}, #{purpose}, #{inboundEventId}, #{runId}, #{botBindingId},
             #{enterpriseId}, #{enterpriseMemberId}, #{userId}, #{msgType},
             #{sourcePayloadHash}, #{contentHash}, #{cipherAlgorithm}, #{keyRef},
             #{keyVersion}, #{nonce}, #{ciphertext}, #{aadHash}, #{plaintextSize}, #{status},
             #{expiresAt}, NOW(), NOW())
    </insert>

    <select id="selectByInboundEventIdForUpdate" resultMap="ArtifactResult">
        SELECT * FROM fbs_smartbot_input_artifact
        WHERE inbound_event_id = #{inboundEventId}
        FOR UPDATE
    </select>

    <select id="selectByRunIdForUpdate" resultMap="ArtifactResult">
        SELECT * FROM fbs_smartbot_input_artifact
        WHERE run_id = #{runId}
        FOR UPDATE
    </select>
</mapper>
